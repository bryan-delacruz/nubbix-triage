# Copia este archivo a .env y completa tus valores:  cp .env.example .env
# .env está en .gitignore: nunca se sube al repositorio.

# --- Credenciales (obligatorias para el proveedor que uses) ---
# Gemini: key gratuita en https://aistudio.google.com
GEMINI_API_KEY=
# Anthropic: key en https://platform.claude.com (cuentas nuevas reciben créditos de prueba)
ANTHROPIC_API_KEY=

# --- Proveedor por defecto: gemini | anthropic ---
LLM_PROVIDER=gemini

# --- Modelos ---
# Por defecto, el modelo más económico y vigente de cada proveedor
# (precios USD por 1M tokens, entrada / salida, verificados el 2026-10-29):
#   gemini-3.1-flash-lite  $0.25 / $1.50  (gratis en la capa gratuita de Google AI Studio)
#   claude-haiku-5-5       $0.10 / $0.50  (prompts de hasta 100.000 tokens)
GEMINI_MODEL=gemini-3.1-flash-lite
ANTHROPIC_MODEL=claude-haiku-5-5

# --- API HTTP (src/api.py) ---
# Si tiene valor, cada request a la API debe mandar el header X-API-Key con este token.
API_TOKEN=
# Requests por minuto permitidos por IP.
RATE_LIMIT_PER_MINUTE=30
